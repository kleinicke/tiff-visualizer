{
  "name": "tiff-visualizer",
  "displayName": "Scientific Image Visualizer",
  "description": "Rust-based decoding and GPU rendering for more than 25 integer and floating-point image formats, with precise pixel inspection, multidimensional navigation, interactive visualization, comparison, and layer compositing.",
  "version": "1.10.1",
  "packageManager": "npm@11.17.0",
  "publisher": "kleinicke",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "browser": "./out/extension.web.js",
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "qna": "https://github.com/kleinicke/tiff-visualizer/issues",
  "galleryBanner": {
    "color": "#1e2e1e",
    "theme": "dark"
  },
  "keywords": [
    "tiff",
    "tif",
    "exr",
    "openexr",
    "ppm",
    "pgm",
    "pbm",
    "pfm",
    "image",
    "viewer",
    "visualizer",
    "wasm",
    "float",
    "scientific",
    "raster",
    "depth",
    "analysis",
    "pixel",
    "gamma",
    "uint16",
    "float16",
    "hdr",
    "jxl",
    "jpeg xl",
    "nan",
    "mask",
    "preview",
    "netpbm",
    "png",
    "jpg",
    "jpeg",
    "npy",
    "ome-tiff",
    "multi-page",
    "fits",
    "dicom",
    "medical imaging",
    "netcdf",
    "czi",
    "nd2",
    "lif",
    "zeiss",
    "microscopy",
    "openraster",
    "ora",
    "kra",
    "krita",
    "psd",
    "photoshop",
    "psb",
    "xcf",
    "gimp",
    "affinity photo",
    "afphoto",
    "layered image",
    "layers"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "tiffVisualizer.previewEditor",
        "displayName": "Scientific Image Visualizer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.{tif,tiff,tf2,tf8,btf,exr,pfm,npy,npz,ppm,pgm,pbm,hdr,tga,jxl,jxr,wdp,hdp,jp2,jpf,jpx,j2k,j2c,jpc,fits,fit,fts,dcm,dicom,DCM,DICOM,nc,cdf,czi,nd2,lif,ora,kra,psd,psb,xcf,afphoto,af}"
          }
        ]
      },
      {
        "viewType": "tiffVisualizer.previewEditor.option",
        "displayName": "Scientific Image Visualizer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.{png,jpeg,jpg,bmp,ico,webp,avif}"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "tiffVisualizer.openDicomFolder",
        "title": "Open Folder as DICOM Dataset",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.zoomIn",
        "title": "Zoom In",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.zoomOut",
        "title": "Zoom Out",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.copyImage",
        "title": "Copy Image",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.pastePosition",
        "title": "Paste Position",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.resetZoom",
        "title": "Reset Zoom",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.setNormalizationRange",
        "title": "Set Normalization Range",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.exportLayers",
        "title": "Export…",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.setGamma",
        "title": "Set Gamma",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.setBrightness",
        "title": "Set Brightness",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.selectForCompare",
        "title": "Select Image for Side-by-Side Compare",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.compareWithSelected",
        "title": "Compare Side by Side with Selected",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.toggleLayers",
        "title": "Open Layers View",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.addLayer",
        "title": "Add Image as Layer",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.toggleNanColor",
        "title": "Toggle NaN Color (Black/Fuchsia)",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.browseAndAddToCollection",
        "title": "Add Images to Collection",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.openComparisonPanel",
        "title": "Open Comparison Gallery (Legacy Renderer)",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.resetAllSettings",
        "title": "Reset All Settings to Defaults",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.toggleHistogram",
        "title": "Toggle Histogram",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.toggleMetadata",
        "title": "Toggle Metadata Panel",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.toggleMeasure",
        "title": "Measure",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.toggleChannels",
        "title": "Channels",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.toggleScaleBar",
        "title": "Toggle Scale Bar",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.convertColormapToFloat",
        "title": "Decode Colormap Image to Float",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.applyColormap",
        "title": "Apply Colormap (Pseudocolor)",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.toggleDebayer",
        "title": "Debayer (Demosaic CFA Image)",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.revertToOriginal",
        "title": "Revert to Original Image",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.toggleColorPickerMode",
        "title": "Toggle Color Picker: Show Modified Values",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.copyImageInfo",
        "title": "Copy Image Information to Clipboard",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.toggleRgb24Mode",
        "title": "Toggle RGB as 24-bit Grayscale",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.openAsPointCloud",
        "title": "Open as Point Cloud",
        "category": "Scientific Image Visualizer"
      },
      {
        "command": "tiffVisualizer.showDocumentation",
        "title": "Show Documentation",
        "category": "Scientific Image Visualizer"
      }
    ],
    "keybindings": [
      {
        "command": "tiffVisualizer.toggleHistogram",
        "key": "ctrl+h",
        "mac": "cmd+h",
        "when": "activeCustomEditorId =~ /^tiffVisualizer\\.previewEditor(?:\\.option)?$/"
      },
      {
        "command": "tiffVisualizer.toggleMetadata",
        "key": "ctrl+m",
        "mac": "cmd+m",
        "when": "activeCustomEditorId =~ /^tiffVisualizer\\.previewEditor(?:\\.option)?$/"
      },
      {
        "command": "tiffVisualizer.toggleMeasure",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "activeCustomEditorId =~ /^tiffVisualizer\\.previewEditor(?:\\.option)?$/"
      },
      {
        "command": "tiffVisualizer.copyImageInfo",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "activeCustomEditorId =~ /^tiffVisualizer\\.previewEditor(?:\\.option)?$/"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tiffVisualizer.browseAndAddToCollection",
          "title": "Add Image to Visualizer Collection",
          "when": "resourceExtname =~ /^\\.(png|jpe?g|tiff?|exr|pfm|npy|npz|pp[mgb]|hdr|tga|webp|avif|bmp|ico|jxl|fits?|fts|dcm|dicom|nc|cdf|czi|nd2|lif|ora|kra|psd|psb|xcf|afphoto|af)$/i && tiffVisualizer.activeMode != 'layers'",
          "group": "navigation@1"
        },
        {
          "command": "tiffVisualizer.browseAndAddToCollection",
          "title": "Add Folder Images to Visualizer Collection",
          "when": "explorerResourceIsFolder && tiffVisualizer.activeMode != 'layers'",
          "group": "navigation@1"
        },
        {
          "command": "tiffVisualizer.addLayer",
          "title": "Add Image as Layer",
          "when": "resourceExtname =~ /^\\.(png|jpe?g|tiff?|exr|pfm|npy|npz|pp[mgb]|hdr|tga|webp|avif|bmp|ico|jxl|fits?|fts|dcm|dicom|nc|cdf|czi|nd2|lif|ora|kra|psd|psb|xcf|afphoto|af)$/i && tiffVisualizer.hasActivePreview && tiffVisualizer.activeMode == 'layers'",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "tiffVisualizer.showDocumentation",
          "when": "activeCustomEditorId =~ /^tiffVisualizer\\.previewEditor(?:\\.option)?$/",
          "group": "z_help@1"
        },
        {
          "command": "tiffVisualizer.selectForCompare",
          "when": "activeCustomEditorId =~ /^tiffVisualizer\\.previewEditor(?:\\.option)?$/",
          "group": "comparison@1"
        },
        {
          "command": "tiffVisualizer.compareWithSelected",
          "when": "activeCustomEditorId =~ /^tiffVisualizer\\.previewEditor(?:\\.option)?$/ && tiffVisualizer.hasComparisonImage",
          "group": "comparison@1"
        }
      ]
    },
    "configuration": {
      "title": "Scientific Image Visualizer",
      "properties": {
        "tiffVisualizer.gpuAcceleration": {
          "type": "boolean",
          "default": true,
          "description": "Use GPU acceleration via WebGPU or WebGL2 for supported image rendering paths. Disable this if a GPU/driver causes incorrect output or slower rendering."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile:quick",
    "clean": "rimraf out",
    "build:wasm": "cd wasm/tiff-decoder && RUSTFLAGS=\"-C target-feature=+simd128\" wasm-pack build --target web --release && cd ../.. && mkdir -p media/wasm && cp wasm/tiff-decoder/pkg/tiff_wasm.js media/wasm/tiff-wasm.js && cp wasm/tiff-decoder/pkg/tiff_wasm_bg.wasm media/wasm/tiff-wasm.wasm && node -e \"const fs=require('fs');const f='media/wasm/tiff-wasm.js';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/tiff_wasm_bg\\.wasm/g,'wasm/tiff-wasm.wasm'))\" && node scripts/strip-wasm-names.mjs media/wasm/tiff-wasm.wasm",
    "build:wasm:codecs": "cd wasm/tiff-decoder && RUSTFLAGS=\"-C target-feature=+simd128\" wasm-pack build --target web --release --out-dir pkg-codecs --out-name codec_wasm --features heavy-codecs && cd ../.. && mkdir -p media/wasm && cp wasm/tiff-decoder/pkg-codecs/codec_wasm.js media/wasm/codec-wasm.js && cp wasm/tiff-decoder/pkg-codecs/codec_wasm_bg.wasm media/wasm/codec-wasm.wasm && node -e \"const fs=require('fs');const f='media/wasm/codec-wasm.js';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/codec_wasm_bg\\.wasm/g,'wasm/codec-wasm.wasm'))\" && node scripts/strip-wasm-names.mjs media/wasm/codec-wasm.wasm",
    "build:wasm:jxl": "cd wasm/jxl-decoder && RUSTFLAGS=\"-C target-feature=+simd128\" wasm-pack build --target web --release && cd ../.. && mkdir -p media/wasm && cp wasm/jxl-decoder/pkg/jxl_wasm.js media/wasm/jxl-wasm.js && cp wasm/jxl-decoder/pkg/jxl_wasm_bg.wasm media/wasm/jxl-wasm.wasm && node -e \"const fs=require('fs');const f='media/wasm/jxl-wasm.js';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/jxl_wasm_bg\\.wasm/g,'wasm/jxl-wasm.wasm'))\" && node scripts/strip-wasm-names.mjs media/wasm/jxl-wasm.wasm",
    "compile": "npm run clean && npm run build:wasm && npm run build:wasm:codecs && npm run build:wasm:jxl && node ./esbuild.js",
    "compile:quick": "npm run clean && node ./esbuild.js",
    "watch": "npm run clean && node ./esbuild.js --watch",
    "web:build": "node scripts/build-web.mjs",
    "web:dev": "npm run web:build && node scripts/serve-web.mjs",
    "test:web": "npm run web:build && playwright test --config web/playwright.config.ts",
    "check": "npm run typecheck && npm run test",
    "goldens:capture": "node scripts/capture-goldens.js",
    "docs:commands": "node scripts/generate-command-docs.js",
    "docs:check": "node scripts/generate-command-docs.js --check",
    "pretest": "npm run compile:quick && npm run lint && npm run docs:check",
    "lint": "eslint src media/imagePreview.ts media/decode-worker.ts media/png-decode-worker.ts media/layered-decode-worker.ts media/layered-preview-fallback.ts media/layer-document-writer-entry.ts media/imagej-roi-entry.ts media/layer-compositor-worker.ts media/comparisonPanel.ts media/modules web --ext ts,js",
    "typecheck": "npm run typecheck:src && npm run typecheck:media && npm run typecheck:web",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:media": "tsc -p media/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "npm run test:format-registry && npm run test:geotiff && npm run test:main-thread-wasm-wiring && npm run test:tiff-parallel-routing && npm run test:format-defaults && npm run test:session-settings && npm run test:web-host && npm run test:behavior && npm run test:visualization && npm run test:compositor && npm run test:layers-panel && npm run test:control-behavior && npm run test:wasm && npm run test:strip-parallel && npm run test:tiff-layout && npm run test:rust-netpbm && npm run test:rust-npy && npm run test:fast-raw && npm run test:wasm-buffer-reuse && npm run test:rust-scientific && npm run test:rust-stats && npm run test:formats && npm run test:layered-formats && npm run test:scientific-formats && npm run test:microscopy-matrix && npm run test:dicom-dataset && npm run test:tiff-sample-formats && npm run test:ome-tiff && npm run test:tiff-pages && npm run test:image-renderer-channels && npm run test:collection-switch && npm run test:debayer && npm run test:measurement && npm run test:rust-measure && npm run test:channels",
    "test:unit": "npm run test:compositor && npm run test:layers-panel && npm run test:control-behavior",
    "test:integration": "npm run test:playwright",
    "test:format-defaults": "node test/format-defaults-test.js",
    "test:format-registry": "node test/format-registry-test.js",
    "test:geotiff": "node test/geotiff-test.js",
    "test:main-thread-wasm-wiring": "node test/main-thread-wasm-wiring-test.js",
    "test:tiff-parallel-routing": "node test/tiff-parallel-routing-test.js",
    "test:web-host": "node test/browser-dataset-test.js",
    "test:behavior": "npm run compile && node test/simple-behavior-test.js",
    "test:scientific-formats": "node test/scientific-formats-test.js",
    "test:microscopy-matrix": "node test/microscopy-matrix-test.js",
    "test:dicom-dataset": "node test/dicom-dataset-test.js",
    "test:visualization": "node test/visualization-test.js",
    "test:debayer": "node test/debayer-test.js",
    "test:measurement": "node test/measurement-test.js",
    "test:rust-measure": "node test/rust-measure-conformance-test.js",
    "test:channels": "node test/channel-composite-test.js",
    "test:compositor": "node test/layer-compositor-test.js",
    "test:layers-panel": "node test/layers-panel-tree-test.js",
    "test:control-behavior": "node test/control-behavior-test.js",
    "test:wasm": "node test/wasm-tiff-decode-test.js",
    "test:strip-parallel": "node test/strip-parallel-conformance-test.js",
    "test:tiff-layout": "node test/tiff-bitdepth-matrix-test.js",
    "test:rust-netpbm": "node test/rust-netpbm-conformance-test.js",
    "test:rust-npy": "node test/rust-npy-conformance-test.js",
    "test:fast-raw": "node test/fast-raw-decoders-test.mjs",
    "test:wasm-buffer-reuse": "node test/wasm-buffer-reuse-test.mjs",
    "test:rust-scientific": "node test/rust-scientific-conformance-test.js",
    "test:rust-stats": "node test/rust-stats-conformance-test.js",
    "test:formats": "node test/format-decode-test.js",
    "test:layered-formats": "node test/layered-preview-test.js",
    "test:tiff-sample-formats": "node test/tiff-sample-format-test.js",
    "test:ome-tiff": "node test/ome-tiff-test.js",
    "test:image-renderer-channels": "node test/image-renderer-channels-test.js",
    "test:collection-switch": "tsc -p tsconfig.json && node test/collection-switch-render-test.js",
    "benchmark:layers": "npm run compile:quick && node test/layer-compositor-benchmark.js",
    "benchmark:accelerators": "npm run compile:quick && playwright test test/playwright/accelerator-speed.spec.ts --workers=1 --headed",
    "benchmark:accelerators:software": "npm run compile:quick && playwright test test/playwright/accelerator-speed.spec.ts --workers=1",
    "benchmark:decoders:ab": "node scripts/benchmark-decoders-head-to-head.mjs",
    "benchmark:vscode": "node scripts/benchmark-vscode.mjs",
    "benchmark:vscode:ab": "node scripts/benchmark-vscode-head-to-head.mjs",
    "benchmark:corpus": "node scripts/benchmark-corpus.mjs",
    "compare:wasm": "node scripts/compare-wasm-builds.mjs",
    "benchmark:decoder-strategies": "node scripts/benchmark-decoder-strategies.mjs",
    "benchmark:layers:4k": "npm run compile:quick && LAYER_BENCH_PRESET=4k node test/layer-compositor-benchmark.js",
    "benchmark:layers:8k": "npm run compile:quick && LAYER_BENCH_PRESET=8k node test/layer-compositor-benchmark.js",
    "test:ui": "npm run compile && extest setup-and-run out/test/ui/**/*.js",
    "test:ui-setup": "extest setup-tests",
    "test:ui-run": "extest run-tests out/test/ui/**/*.js",
    "test:playwright": "playwright test test/playwright/extension-core.spec.ts test/playwright/layer-compositor-worker.spec.ts test/playwright/gpu-layer-compositor.spec.ts test/playwright/webgpu-layer-compositor.spec.ts",
    "build": "webpack",
    "test:session-settings": "node test/session-settings-test.js",
    "test:tiff-pages": "node test/tiff-pages-test.js"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "fflate": "^0.8.3",
    "geotiff": "^2.1.3",
    "pako": "^2.1.0",
    "parse-exr": "^1.0.2",
    "parse-hdr": "^1.0.0",
    "tga-js": "^1.1.1",
    "tslib": "^2.8.1",
    "upng-js": "^2.1.0",
    "vscode-uri": "^3.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.70.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "chai": "^4.3.0",
    "esbuild": "^0.25.5",
    "eslint": "^8.57.0",
    "mocha": "^10.4.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.4.5",
    "vscode-extension-tester": "^8.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kleinicke/tiff-visualizer.git"
  }
}
