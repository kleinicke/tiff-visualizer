<idea-plugin>
  <id>imagevisualizer</id>
  <name>Scientific Image Visualizer</name>
  <vendor url="https://f-kleinicke.de">Florian Kleinicke</vendor>
  <!-- <description> is generated from jetbrains/DESCRIPTION.md by build.gradle.kts. -->
  <change-notes>0.4.4 — Keep microscopy previews updating during continuous navigation while preserving the latest requested position.</change-notes>
  <depends>com.intellij.modules.platform</depends>
  <depends optional="true" config-file="jcef.xml">com.intellij.modules.jcef</depends>
  <extensions defaultExtensionNs="com.intellij">
    <!-- generated file types -->
    <fileType name="Scientific Image" implementationClass="de.kleinicke.visualizer.ScientificImageFileType" fieldName="INSTANCE" extensions="af;afphoto;btf;bw;cdf;czi;dcm;dicom;exr;fit;fits;fts;hdp;hdr;j2c;j2k;jp2;jpc;jpf;jpx;jxl;jxr;kra;lif;nc;nd2;npy;npz;ora;pbm;pfm;pgm;ppm;psb;psd;rgb;rgba;sdt;sgi;tf2;tf8;tga;wdp;xcf"/>
    <!-- end generated file types -->
    <fileEditorProvider implementation="de.kleinicke.visualizer.VisualizerEditorProvider"/>
    <statusBarWidgetFactory id="ScientificImage.zoom" implementation="de.kleinicke.visualizer.ImageStatusWidgetFactory$Zoom"/>
    <statusBarWidgetFactory id="ScientificImage.size" implementation="de.kleinicke.visualizer.ImageStatusWidgetFactory$Size" order="after ScientificImage.zoom"/>
    <statusBarWidgetFactory id="ScientificImage.normalization" implementation="de.kleinicke.visualizer.ImageStatusWidgetFactory$Normalization" order="after ScientificImage.size"/>
    <statusBarWidgetFactory id="ScientificImage.gamma" implementation="de.kleinicke.visualizer.ImageStatusWidgetFactory$Gamma" order="after ScientificImage.normalization"/>
    <statusBarWidgetFactory id="ScientificImage.exposure" implementation="de.kleinicke.visualizer.ImageStatusWidgetFactory$Exposure" order="after ScientificImage.gamma"/>
    <statusBarWidgetFactory id="ScientificImage.bytes" implementation="de.kleinicke.visualizer.ImageStatusWidgetFactory$Bytes" order="after ScientificImage.exposure"/>
  </extensions>
</idea-plugin>
