{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.svelte",
    "../web/**/*.svelte",
    "../media/types/**/*.d.ts"
  ]
}
